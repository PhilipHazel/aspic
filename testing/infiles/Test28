box width * depth * filled purple;
pop;
goto A;
box depth *;
B: line down 10 thickness 40;
D: line up * colour 1,0,0 thickness 5;
iline down * thickness *;
line right 5 down * thickness *;
line down copy B;
C: arc angle 20;
arc angle * colour 1,0,0;
arc angle copy C colour 0,1,0;
line right 20 thickness 4 grey 0.5;
line up grey * thickness copy D;
line left 60 colour copy D;
